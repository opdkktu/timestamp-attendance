function renderQ7Multi(type, q){
  var listEl=document.getElementById("q7-"+type+"-list");
  var items = type==="proc" ? Q7_RANGES.procedures : Q7_RANGES.medications;
  var sel = Q7_SEL[type];
  var qLow=(q||"").toLowerCase().trim();
  var filtered = qLow ? items.filter(function(x){ return x.toLowerCase().indexOf(qLow)!==-1; }) : items.slice();
  filtered.sort(function(a,b){ var aC=!!sel[a],bC=!!sel[b]; if(aC&&!bC) return -1; if(!aC&&bC) return 1; return a.localeCompare(b); });
  if(!filtered.length){ listEl.innerHTML="<div style='padding:10px;font-size:12px;color:var(--tx3);'>Tiada padanan</div>"; return; }
  listEl.innerHTML="";
  filtered.forEach(function(item){
    var checked=!!sel[item];
    var div=document.createElement("div");
    div.className="q7-multi-item"+(checked?" checked":"");
    var chk=document.createElement("input"); chk.type="checkbox"; if(checked) chk.checked=true;
    var lbl=document.createElement("span"); lbl.textContent=item; lbl.style.flex="1";
    div.appendChild(chk); div.appendChild(lbl);
    div.onclick=function(){
      chk.checked=!chk.checked;
      if(chk.checked) sel[item]=true; else delete sel[item];
      renderQ7Multi(type, document.getElementById("q7-"+type+"-search").value);
      renderQ7Tags(type);
    };
    listEl.appendChild(div);
  });
}
function renderQ7Tags(type){
  var tagsEl=document.getElementById("q7-"+type+"-tags");
  var keys=Object.keys(Q7_SEL[type]);
  if(!keys.length){ tagsEl.innerHTML="<span style='font-size:12px;color:var(--tx3);font-style:italic;'>Tiada dipilih</span>"; return; }
  tagsEl.innerHTML=keys.map(function(k){
    return "<span class='q7-sel-tag'>"+k+"<span class='rm' onclick=\"removeQ7Sel('"+type+"','"+k.replace(/'/g,"\\'")+"')\">✕</span></span>";
  }).join("");
}
