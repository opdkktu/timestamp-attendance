<script>
/* SIAGA bridge: this page runs inside SIAGA, so e-Clerking calls go  browser → SIAGA → e-Clerking project (server to server).
   It replaces Apps Script's google.script.run with the same chaining API, so the form code below is unchanged. */
(function(){
  var API = "https://script.google.com/macros/s/AKfycbxOamlCtYPlZCvQOys1VTjkZu7aVqMsdDStTdytPex7eH5jNGuIBiR91BfougaEF3SI/exec";
  var TOKEN = sessionStorage.getItem("kkah_session_token");
  if(!TOKEN){ location.replace("./login.html"); }
  var STATIC = { getPickLists:1, getVitalsConfig:1, getBilikKecemasanRanges:1, getDiagnosisList:1 };   // pick-lists: remembered 10 min on this phone
  function sget(k){ try{ var v = JSON.parse(sessionStorage.getItem("kkah_ec_"+k)||"null"); return v && Date.now()-v.t < 600000 ? v.d : null; }catch(e){ return null; } }
  function sset(k,d){ try{ sessionStorage.setItem("kkah_ec_"+k, JSON.stringify({t:Date.now(),d:d})); }catch(e){} }
  function call(fn, args, ok, fail){
    if(STATIC[fn]){ var c = sget(fn); if(c){ if(ok) setTimeout(function(){ ok(c); },0); return; } }
    var ctl = new AbortController(), t = setTimeout(function(){ ctl.abort(); }, 45000);
    fetch(API, { method:"POST", headers:{ "Content-Type":"text/plain;charset=utf-8" }, body:JSON.stringify({ action:"eclerkCall", token:TOKEN, fn:fn, args:args }), signal:ctl.signal })
      .then(function(r){ return r.json(); })
      .then(function(d){
        clearTimeout(t);
        if(d && d.ok){
          if(STATIC[fn] && d.result && d.result.status==="success") sset(fn, d.result);
          if(fn==="addBkRange"){ try{ sessionStorage.removeItem("kkah_ec_getBilikKecemasanRanges"); }catch(e){} }
          if(ok) ok(d.result);
        }
        else if(d && /expired/i.test(d.error || "")){ location.replace("./login.html"); }
        else if(fail) fail(new Error((d && d.error) || "Ralat"));
      })
      .catch(function(e){ clearTimeout(t); if(fail) fail(new Error(e && e.name === "AbortError" ? "Masa tamat. Semak sambungan." : (e && e.message) || "Ralat sambungan")); });
  }
  function make(ok, fail){
    var base = { withSuccessHandler:function(f){ return make(f, fail); }, withFailureHandler:function(f){ return make(ok, f); } };
    return new Proxy(base, { get:function(t, k){ if(k in t) return t[k]; return function(){ call(String(k), Array.prototype.slice.call(arguments), ok, fail); }; } });
  }
  window.google = { script:{ run: make(null, null) } };
})();
</script>
<script>
var TOTAL_Q = 6;
var curQ = 1;
var CURRENT = { rowIndex:null, identifier:"", nama:"" };
var OTHERS_LABEL = "Lain-lain";
var SYMPTOM_LIST = [];
var SEL_SYMPTOMS = {};
var OTHERS_SYM = { checked:false, text:"" };

// ── init from server-rendered params ──
function stripQuotesClient(s){
  return String(s==null?"":s).trim().replace(/^["'\u2018\u2019\u201C\u201D\u00AB\u00BB]+|["'\u2018\u2019\u201C\u201D\u00AB\u00BB]+$/g,"").trim();
}
function goBackToKaunter(){ location.href = "./eclerk-find.html"; }
var __Q = new URLSearchParams(location.search);
var NAMA     = stripQuotesClient((__Q.get("nama")||""));
var IC       = stripQuotesClient((__Q.get("ic")||""));
var PASSPORT = stripQuotesClient((__Q.get("passport")||""));
var TLAHIR   = (__Q.get("tlahir")||"");
var PHONE    = stripQuotesClient((__Q.get("phone")||""));
var PATIENT_AGE = null;

function calcAgeFromIcClient(ic){
  ic = String(ic||"").replace(/\D/g,"");
  if(ic.length!==12) return null;
  var yy=parseInt(ic.substring(0,2)),mm=parseInt(ic.substring(2,4)),dd=parseInt(ic.substring(4,6));
  var now=new Date(),fy=yy<=(now.getFullYear()%100)?2000+yy:1900+yy;
  var dob=new Date(fy,mm-1,dd),age=now.getFullYear()-dob.getFullYear();
  if(now.getMonth()<dob.getMonth()||(now.getMonth()===dob.getMonth()&&now.getDate()<dob.getDate())) age--;
  return age;
}

function renderPatientBanner(){
  document.getElementById("patName").textContent = NAMA || "—";
  var initials=(NAMA||"?").split(" ").map(function(w){return w[0]||"";}).slice(0,2).join("").toUpperCase();
  document.getElementById("patAvatar").textContent = initials || "?";

  var identifier = IC && IC.length ? IC : PASSPORT;
  CURRENT.identifier = identifier;
  document.getElementById("patIc").textContent = IC ? IC : ("Pasport: "+(PASSPORT||"—"));

  var age = null;
  if(IC && IC.replace(/\D/g,"").length===12){ age = calcAgeFromIcClient(IC); }
  else if(TLAHIR){ var y=parseInt(TLAHIR,10); if(y) age = new Date().getFullYear()-y; }
  PATIENT_AGE = age;
  document.getElementById("patAge").textContent = age!==null ? (age+" tahun") : "Umur tidak diketahui";

  if(PHONE){ var ph=document.getElementById("patPhone"); ph.textContent="📞 "+PHONE; ph.style.display=""; }
}

function setSaveStatus(type,msg){
  var el=document.getElementById("saveStatus");
  el.className="save-status "+(type||"");
  el.textContent=msg||"";
  if(type==="ok") setTimeout(function(){ if(el.textContent===msg) el.textContent=""; },2000);
}

// ── SUCCESS OVERLAY (SMART-style, shared) ──
function showSuccessOverlay(title,name,msg){
  try{ var a=document.getElementById("sndSuccess"); a.currentTime=0; a.play(); }catch(ex){}
  document.getElementById("ovTitle").textContent=title;
  document.getElementById("ovName").textContent=name||"";
  document.getElementById("ovMsg").textContent=msg||"";
  document.getElementById("successOverlay").classList.add("show");
}
function closeSuccessOverlay(){ document.getElementById("successOverlay").classList.remove("show"); }

// ── SECTION NAV + VALIDATION + ENTER-TO-NEXT ──
function showSection(n){
  curQ=n;
  document.querySelectorAll(".qsection").forEach(function(s){ s.classList.remove("active"); });
  document.getElementById("qsec-"+n).classList.add("active");
  document.querySelectorAll(".qnav-btn").forEach(function(b){ b.classList.toggle("active", parseInt(b.dataset.q,10)===n); });
  document.getElementById("btnPrev").disabled = (n===1);
  document.getElementById("btnNext").textContent = (n===TOTAL_Q) ? "Selesai ✓" : "Seterusnya ▶";
  var activeBtn=document.querySelector(".qnav-btn.active");
  if(activeBtn) activeBtn.scrollIntoView({inline:"center",behavior:"smooth"});
}
function navStep(dir){
  var next=curQ+dir;
  if(next<1||next>TOTAL_Q) return;
  showSection(next);
}
function showSectionError(n,msg){
  var el=document.getElementById("qErr-"+n);
  if(!el) return;
  el.textContent=msg;
  el.classList.toggle("show", !!msg);
}
function validateSection(n){
  if(n===1){
    var ok = Object.keys(SEL_SYMPTOMS).length>0 || (OTHERS_SYM.checked && OTHERS_SYM.text.trim().length>0);
    showSectionError(1, ok?"":"Sila tandakan sekurang-kurangnya satu simptom sebelum teruskan.");
    return ok;
  }
  if(n===2){
    var rr=document.getElementById("v-rr").value;
    var ok2 = rr!=="" && PAIN_SCORE!==null;
    showSectionError(2, ok2?"":"RR dan Pain Score wajib diisi sebelum teruskan.");
    return ok2;
  }
  if(n===5){
    var performerVal=document.getElementById("q7-performer").value;
    var ok5 = Q7_KES!==null && performerVal!=="";
    showSectionError(5, ok5?"":"Kes Kecemasan dan Performer wajib diisi sebelum teruskan.");
    return ok5;
  }
  return true;
}
function goNext(){
  if(curQ===TOTAL_Q){ finishClerking(); return; }
  if(!validateSection(curQ)) return;
  showSection(curQ+1);
}
function getFocusableInSection(sectionEl){
  return Array.prototype.slice.call(sectionEl.querySelectorAll("input,select")).filter(function(el){
    return el.offsetParent!==null && el.type!=="checkbox" && el.type!=="radio";
  });
}
document.addEventListener("keydown", function(e){
  if(e.key!=="Enter") return;
  var tag=(e.target.tagName||"").toUpperCase();
  if(tag==="TEXTAREA") return; // allow newline in free-text areas
  if(tag!=="INPUT" && tag!=="SELECT") return;
  if(document.getElementById("successOverlay").classList.contains("show")) return;
  e.preventDefault();
  var activeSection=document.querySelector(".qsection.active");
  if(!activeSection) return;
  var focusables=getFocusableInSection(activeSection);
  var idx=focusables.indexOf(e.target);
  if(idx>-1 && idx<focusables.length-1){
    var nextEl=focusables[idx+1];
    nextEl.focus(); if(nextEl.select) nextEl.select();
  } else {
    goNext();
  }
});
function markFilled(qNum, filled){
  var btn=document.querySelector('.qnav-btn[data-q="'+qNum+'"]');
  if(btn) btn.classList.toggle("filled", !!filled);
}

// ── Q1 SYMPTOMS (+ "Lain-lain" free text) ──
function renderSymptomChips(){
  var wrap=document.getElementById("symptomChips");
  wrap.innerHTML="";
  SYMPTOM_LIST.forEach(function(name){
    var div=document.createElement("div");
    div.className="chip-wrap";
    var chip=document.createElement("div");
    chip.className="chip"+(SEL_SYMPTOMS.hasOwnProperty(name)?" checked":"");
    chip.textContent=name;
    chip.onclick=function(){ toggleSymptom(name,div); };
    var daysBar=document.createElement("div");
    daysBar.className="chip-days"+(SEL_SYMPTOMS.hasOwnProperty(name)?" show":"");
    daysBar.innerHTML="Bilangan hari: <input type='number' min='0' max='60' placeholder='—' value='"+(SEL_SYMPTOMS[name]||"")+"'>";
    daysBar.querySelector("input").oninput=function(){ SEL_SYMPTOMS[name]=this.value; saveQ1(); };
    div.appendChild(chip); div.appendChild(daysBar);
    wrap.appendChild(div);
  });
  var oDiv=document.createElement("div");
  oDiv.className="chip-wrap";
  var oChip=document.createElement("div");
  oChip.className="chip"+(OTHERS_SYM.checked?" checked":"");
  oChip.textContent=OTHERS_LABEL;
  oChip.onclick=function(){ OTHERS_SYM.checked=!OTHERS_SYM.checked; renderSymptomChips(); saveQ1(); };
  var oBox=document.createElement("div");
  oBox.className="chip-days"+(OTHERS_SYM.checked?" show":"");
  var oInp=document.createElement("input");
  oInp.type="text"; oInp.placeholder="Nyatakan simptom lain..."; oInp.style.flex="1"; oInp.value=OTHERS_SYM.text||"";
  oInp.oninput=function(){ OTHERS_SYM.text=this.value; saveQ1(); };
  oBox.appendChild(oInp);
  oDiv.appendChild(oChip); oDiv.appendChild(oBox);
  wrap.appendChild(oDiv);
}
function toggleSymptom(name){
  if(SEL_SYMPTOMS.hasOwnProperty(name)) delete SEL_SYMPTOMS[name];
  else SEL_SYMPTOMS[name]="";
  renderSymptomChips();
  saveQ1();
}
function buildQ1String(){
  var parts=[];
  Object.keys(SEL_SYMPTOMS).forEach(function(name){
    var d=SEL_SYMPTOMS[name];
    parts.push(d ? (name+" ("+d+" hari)") : name);
  });
  if(OTHERS_SYM.checked) parts.push(OTHERS_SYM.text ? (OTHERS_LABEL+": "+OTHERS_SYM.text) : OTHERS_LABEL);
  return parts.join(", ");
}
var _q1Timer=null;
function saveQ1(immediate){
  var run=function(){
    if(!CURRENT.rowIndex) return;
    var str=buildQ1String();
    setSaveStatus("","Menyimpan...");
    google.script.run
      .withSuccessHandler(function(r){ if(r&&r.status==="success"){ setSaveStatus("ok","✓ Disimpan"); markFilled(1, str.length>0); showSectionError(1,""); } else setSaveStatus("err","Ralat simpan"); })
      .withFailureHandler(function(){ setSaveStatus("err","Ralat simpan"); })
      .saveField(CURRENT.rowIndex, "q1", str);
  };
  clearTimeout(_q1Timer);
  if(immediate) run(); else _q1Timer=setTimeout(run,500);
}
function restoreQ1(str){
  if(!str) return;
  var idx=str.indexOf(OTHERS_LABEL);
  var mainPart = idx===-1 ? str : str.substring(0,idx);
  mainPart.split(",").forEach(function(part){
    part=part.trim(); if(!part) return;
    var m=part.match(/^(.*?)\s*\((\d+)\s*hari\)$/);
    if(m){ SEL_SYMPTOMS[m[1].trim()] = m[2]; }
    else { SEL_SYMPTOMS[part] = ""; }
  });
  if(idx!==-1){
    OTHERS_SYM.checked=true;
    OTHERS_SYM.text = str.substring(idx+OTHERS_LABEL.length).replace(/^:\s*/,"").replace(/^,\s*/,"").trim();
  }
  renderSymptomChips();
  markFilled(1,true);
}

// ── Q2 VITALS ──
var VITALS_CONFIG = null;
var PAIN_SCORE = null;

function loadVitalsConfig(cb){
  google.script.run
    .withSuccessHandler(function(cfg){ VITALS_CONFIG = cfg; renderPainScale(); if(cb) cb(); })
    .withFailureHandler(function(){ VITALS_CONFIG = {bp:[],rr:[],glucose:{},pulse:{min:60,max:100},spo2:{min:95}}; renderPainScale(); if(cb) cb(); })
    .getVitalsConfig();
}
function findAgeBand(list, age){
  if(age===null || !list) return null;
  for(var i=0;i<list.length;i++){
    if(age >= list[i].ageMin && age <= list[i].ageMax) return list[i];
  }
  return null;
}
function setFlag(elId, state, text){
  var el=document.getElementById(elId);
  el.className="vital-flag "+state;
  el.textContent=text;
}
function evalBP(){
  var sys=document.getElementById("v-bp-sys").value, dia=document.getElementById("v-bp-dia").value;
  if(!sys && !dia){ setFlag("flag-bp","",""); return; }
  var sysBand=findAgeBand((VITALS_CONFIG.bp||[]).filter(function(b){return b.param==="Systolic";}), PATIENT_AGE);
  var diaBand=findAgeBand((VITALS_CONFIG.bp||[]).filter(function(b){return b.param==="Diastolic";}), PATIENT_AGE);
  if(!sysBand || sysBand.min===null || !diaBand || diaBand.min===null){
    setFlag("flag-bp","nodata","Carta belum ditetapkan"); return;
  }
  var sysAbnormal = sys!=="" && (Number(sys)<sysBand.min || Number(sys)>sysBand.max);
  var diaAbnormal = dia!=="" && (Number(dia)<diaBand.min || Number(dia)>diaBand.max);
  if(sysAbnormal||diaAbnormal) setFlag("flag-bp","abnormal","⚠ Abnormal");
  else setFlag("flag-bp","normal","Normal");
}
function evalPulse(){
  var v=document.getElementById("v-pulse").value;
  if(v==="") { setFlag("flag-pulse","",""); return; }
  var p=VITALS_CONFIG.pulse;
  var ab = Number(v)<p.min || Number(v)>p.max;
  setFlag("flag-pulse", ab?"abnormal":"normal", ab?"⚠ Abnormal":"Normal");
}
function evalSpo2(){
  var v=document.getElementById("v-spo2").value;
  if(v==="") { setFlag("flag-spo2","",""); return; }
  var ab = Number(v) < VITALS_CONFIG.spo2.min;
  setFlag("flag-spo2", ab?"abnormal":"normal", ab?"⚠ Abnormal":"Normal");
}
function evalRR(){
  var v=document.getElementById("v-rr").value;
  if(v===""){ setFlag("flag-rr","",""); return; }
  var band=findAgeBand(VITALS_CONFIG.rr, PATIENT_AGE);
  if(!band || band.min===null){ setFlag("flag-rr","nodata","Carta belum ditetapkan"); return; }
  var ab = Number(v)<band.min || Number(v)>band.max;
  setFlag("flag-rr", ab?"abnormal":"normal", ab?"⚠ Abnormal":"Normal");
}
function evalGlucose(){
  var v=document.getElementById("v-glu").value;
  var g=VITALS_CONFIG.glucose||{};
  if(v===""){ setFlag("flag-glu-fast","nodata","Berpuasa: —"); setFlag("flag-glu-rand","nodata","Rawak: —"); return; }
  var val=Number(v);
  if(g.fastingMin===null||g.fastingMin===undefined){ setFlag("flag-glu-fast","nodata","Berpuasa: belum ditetapkan"); }
  else{ var fAb = val<g.fastingMin || val>g.fastingMax; setFlag("flag-glu-fast", fAb?"abnormal":"normal", "Berpuasa: "+(fAb?"⚠ Abnormal":"Normal")); }
  if(g.randomMin===null||g.randomMin===undefined){ setFlag("flag-glu-rand","nodata","Rawak: belum ditetapkan"); }
  else{ var rAb = val<g.randomMin || val>g.randomMax; setFlag("flag-glu-rand", rAb?"abnormal":"normal", "Rawak: "+(rAb?"⚠ Abnormal":"Normal")); }
}
function renderPainScale(){
  var wrap=document.getElementById("painScale");
  wrap.innerHTML="";
  for(var i=0;i<=10;i++){
    (function(n){
      var b=document.createElement("button");
      b.type="button"; b.className="pain-btn"; b.textContent=n;
      if(PAIN_SCORE===n) b.classList.add(painClass(n));
      b.onclick=function(){ PAIN_SCORE=n; renderPainScale(); onVitalInput(); };
      wrap.appendChild(b);
    })(i);
  }
  var lbl=document.getElementById("painLabel");
  if(!lbl){
    lbl=document.createElement("div"); lbl.id="painLabel"; lbl.className="pain-label";
    wrap.parentNode.appendChild(lbl);
  }
  lbl.textContent = PAIN_SCORE!==null ? painText(PAIN_SCORE) : "";
  lbl.style.color = PAIN_SCORE!==null ? painColor(PAIN_SCORE) : "";
}
