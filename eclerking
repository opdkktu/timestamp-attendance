<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>SIAGA · e-Clerking</title>
<link rel="icon" type="image/png" href="./siaga-192.png">
<link rel="manifest" href="./manifest.json">
<meta name="theme-color" content="#0F4530">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F5F3EE;--sf:#fff;--sf2:#F0EDE7;--bd:#D9D5CC;
  --tx:#1C1C1A;--tx2:#6B6860;--tx3:#9B9890;
  --ac:#1A6B4A;--acl:#E3F0EB;--acd:#0F4530;
  --dg:#C0392B;--r:10px;--rl:14px;
  --blue:#185FA5;--warn:#D97706;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:"IBM Plex Sans",sans-serif;background:var(--bg);color:var(--tx);min-height:100vh;padding-bottom:6rem;}

/* ── LOADING OVERLAY ── */
#loadOverlay{position:fixed;inset:0;background:rgba(15,69,48,.92);z-index:999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;color:#fff;}
.loadSpin{width:44px;height:44px;border:4px solid rgba(255,255,255,.25);border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}
#loadOverlay.hide{display:none;}
#loadOverlay p{font-size:13px;color:rgba(255,255,255,.75);letter-spacing:.03em;}

/* ── HEADER / PATIENT BANNER ── */
header{background:var(--acd);color:#fff;padding:14px 18px;position:sticky;top:0;z-index:100;box-shadow:0 2px 12px rgba(0,0,0,.15);}
header h1{font-size:15px;font-weight:700;letter-spacing:.02em;}
.patient-banner{background:var(--sf);margin:14px;border-radius:var(--rl);padding:16px 18px;border:1px solid var(--bd);display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
.pat-avatar{width:48px;height:48px;border-radius:50%;background:var(--acl);color:var(--acd);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;flex-shrink:0;}
.pat-info{flex:1;min-width:180px;}
.pat-name{font-size:16px;font-weight:700;}
.pat-meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:4px;font-size:12px;color:var(--tx2);}
.pat-meta span{background:var(--sf2);border-radius:20px;padding:3px 10px;font-family:"IBM Plex Mono",monospace;}
.pat-age{background:var(--acl)!important;color:var(--acd);font-weight:600;font-family:"IBM Plex Sans",sans-serif!important;}
.save-status{font-size:11px;color:var(--tx3);white-space:nowrap;}
.save-status.ok{color:var(--ac);font-weight:600;}
.save-status.err{color:var(--dg);font-weight:600;}

/* ── SECTION NAV ── */
.qnav{display:flex;gap:6px;overflow-x:auto;padding:0 14px 10px;-webkit-overflow-scrolling:touch;}
.qnav::-webkit-scrollbar{display:none;}
.qnav-btn{flex-shrink:0;padding:8px 14px;border-radius:20px;border:1px solid var(--bd);background:var(--sf);font-size:12px;font-weight:600;color:var(--tx2);cursor:pointer;white-space:nowrap;transition:all .15s;}
.qnav-btn.active{background:var(--acd);color:#fff;border-color:var(--acd);}
.qnav-btn.filled::after{content:" ✓";color:var(--ac);}
.qnav-btn.active.filled::after{color:#9BE8C4;}

/* ── SECTIONS ── */
.qsection{display:none;margin:0 14px 14px;background:var(--sf);border:1px solid var(--bd);border-radius:var(--rl);padding:18px;}
.qsection.active{display:block;animation:fadeIn .2s ease;}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}
.qtitle{font-size:13px;font-weight:700;color:var(--tx);margin-bottom:4px;}
.qsub{font-size:11.5px;color:var(--tx3);margin-bottom:14px;}
.q-error{display:none;color:var(--dg);font-size:12px;font-weight:600;margin-top:10px;padding:8px 12px;background:#FDECEA;border-radius:var(--r);}
.q-error.show{display:block;}
.q-divider{margin:22px 0 14px;padding-top:18px;border-top:1px solid var(--sf2);}

/* ── MULTI-TICK CHIPS ── */
.chip-grid{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;}
.chip{padding:9px 15px;border-radius:20px;border:1.5px solid var(--bd);background:var(--sf);font-size:13px;font-weight:500;color:var(--tx2);cursor:pointer;transition:all .15s;user-select:none;}
.chip.checked{background:var(--acd);border-color:var(--acd);color:#fff;}
.chip-days{display:none;margin-top:6px;padding:8px 10px;background:var(--sf2);border-radius:var(--r);align-items:center;gap:8px;font-size:12px;}
.chip-days.show{display:flex;}
.chip-days input{width:60px;padding:6px 8px;border:1px solid var(--bd);border-radius:6px;font-size:13px;text-align:center;font-family:"IBM Plex Mono",monospace;}
.chip-wrap{margin-bottom:6px;}

/* ── Q2 VITALS ── */
.vital-grid{display:flex;flex-direction:column;gap:14px;}
.vital-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding-bottom:12px;border-bottom:1px solid var(--sf2);}
.vital-row:last-child{border-bottom:none;padding-bottom:0;}
.vital-row label{width:110px;flex-shrink:0;font-size:13px;font-weight:600;color:var(--tx);}
.vital-input-pair{display:flex;align-items:center;gap:6px;}
.vital-input-pair input{width:78px;padding:9px 10px;border:1.5px solid var(--bd);border-radius:var(--r);font-family:"IBM Plex Mono",monospace;font-size:15px;text-align:center;outline:none;transition:border-color .15s;}
.vital-input-pair input:focus{border-color:var(--acd);box-shadow:0 0 0 3px rgba(15,69,48,.12);}
.vital-sep{font-weight:700;color:var(--tx3);}
.vital-unit{font-size:11px;color:var(--tx3);}
.vital-flag{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;white-space:nowrap;}
.vital-flag.normal{background:var(--acl);color:var(--acd);}
.vital-flag.abnormal{background:#FDECEA;color:var(--dg);animation:blinkFlag 1s ease-in-out infinite;}
.vital-flag.nodata{background:var(--sf2);color:var(--tx3);}
@keyframes blinkFlag{0%,100%{opacity:1;}50%{opacity:.45;}}
.glu-flags{display:flex;flex-direction:column;gap:4px;}
.glu-flags .vital-flag{width:fit-content;}
.pain-scale{display:flex;flex-wrap:wrap;gap:6px;}
.pain-btn{width:34px;height:34px;border-radius:50%;border:1.5px solid var(--bd);background:var(--sf);font-size:13px;font-weight:700;color:var(--tx2);cursor:pointer;transition:all .15s;}
.pain-btn.sel-mild{background:var(--acl);border-color:var(--ac);color:var(--acd);}
.pain-btn.sel-mod{background:#FEF3E7;border-color:var(--warn);color:#8A4900;}
.pain-btn.sel-sev{background:#FDECEA;border-color:var(--dg);color:var(--dg);}
.pain-label{margin-top:6px;font-size:12px;font-weight:600;}
.req-mark{color:var(--dg);font-weight:700;}

/* ── PLAIN TEXT ── */
.plain-textarea{width:100%;padding:12px;border:1.5px solid var(--bd);border-radius:var(--r);font-family:"IBM Plex Sans",sans-serif;font-size:14px;color:var(--tx);outline:none;resize:vertical;min-height:120px;transition:border-color .15s;}
.plain-textarea:focus{border-color:var(--acd);box-shadow:0 0 0 3px rgba(15,69,48,.12);}

/* ── Q7 PROCEDURE / MANAGEMENT ── */
.q7-kes-row{display:flex;gap:10px;margin-bottom:16px;}
.q7-kes-btn{flex:1;padding:11px;border:2px solid var(--bd);border-radius:var(--r);background:var(--sf);font-family:"IBM Plex Sans",sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:all .15s;text-align:center;}
.q7-kes-btn.sel-ya{background:#FEF2F2;border-color:var(--dg);color:var(--dg);}
.q7-kes-btn.sel-tidak{background:var(--acl);border-color:var(--ac);color:var(--acd);}
.q7-subtitle{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--tx2);margin:16px 0 8px;padding-bottom:6px;border-bottom:1px solid var(--sf2);display:flex;align-items:center;gap:8px;}
.q7-add-btn{display:inline-flex;align-items:center;gap:3px;padding:2px 8px;font-size:10px;font-weight:600;border:1px solid rgba(15,69,48,.25);border-radius:4px;background:var(--acl);color:var(--acd);cursor:pointer;font-family:"IBM Plex Sans",sans-serif;text-transform:uppercase;letter-spacing:.04em;margin-left:auto;}
.q7-add-btn:hover{background:var(--acd);color:#fff;}
.q7-add-form{display:none;margin-bottom:10px;padding:10px;background:var(--sf2);border-radius:var(--r);}
.q7-add-form.show{display:block;}
.q7-add-row{display:flex;gap:8px;}
.q7-add-input{flex:1;padding:8px 10px;border:1px solid var(--bd);border-radius:var(--r);font-size:13px;outline:none;}
.q7-add-save{padding:8px 14px;background:var(--acd);color:#fff;border:none;border-radius:var(--r);font-size:12px;font-weight:600;cursor:pointer;}
.q7-add-cancel{padding:8px 12px;border:1px solid var(--bd);border-radius:var(--r);background:var(--sf);font-size:12px;cursor:pointer;}
.q7-add-status{margin-top:6px;font-size:11px;font-weight:500;}
.q7-add-status.err{color:var(--dg);} .q7-add-status.ok{color:var(--ac);}
.q7-multi-wrap{border:1px solid var(--bd);border-radius:var(--r);max-height:180px;overflow-y:auto;}
.q7-multi-search{width:100%;padding:8px 10px;border:none;border-bottom:1px solid var(--bd);background:var(--sf2);font-size:13px;outline:none;position:sticky;top:0;}
.q7-multi-item{display:flex;align-items:center;gap:8px;padding:7px 10px;cursor:pointer;font-size:13px;}
.q7-multi-item:hover{background:var(--sf2);}
.q7-multi-item.checked{background:var(--acl);}
.q7-multi-item input{width:18px;height:18px;flex-shrink:0;}
.q7-sel-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px;min-height:18px;}
.q7-sel-tag{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;background:var(--acl);border-radius:20px;font-size:11px;color:var(--acd);font-weight:500;}
.q7-sel-tag .rm{cursor:pointer;opacity:.7;}
.q7-performer-sel{width:100%;padding:9px 10px;border:1px solid var(--bd);border-radius:var(--r);font-size:14px;outline:none;background:var(--sf);}
.q7b-chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;}
.q7b-note{width:100%;padding:9px 10px;border:1px solid var(--bd);border-radius:var(--r);font-size:13px;outline:none;margin-top:4px;font-family:"IBM Plex Sans",sans-serif;resize:vertical;min-height:70px;}
.q7-submit-btn{width:100%;margin-top:18px;padding:13px;background:var(--acd);color:#fff;border:none;border-radius:var(--r);font-size:14px;font-weight:700;cursor:pointer;}
.q7-submit-btn:disabled{background:var(--tx3);cursor:not-allowed;}
.q7-status{margin-top:8px;font-size:12px;font-weight:600;text-align:center;}
.q7-status.err{color:var(--dg);} .q7-status.ok{color:var(--ac);}
.btn-print{width:100%;margin-top:10px;padding:12px;background:var(--blue);color:#fff;border:none;border-radius:var(--r);font-size:13px;font-weight:700;cursor:pointer;}

.q8-add-row{display:flex;gap:8px;margin-bottom:10px;}
.q8-add-row select, .q8-add-row input{flex:1;}
.q8-add-row button{flex-shrink:0;padding:9px 16px;background:var(--acd);color:#fff;border:none;border-radius:var(--r);font-size:13px;font-weight:600;cursor:pointer;}
.q8-sync-note{font-size:11px;color:var(--tx3);margin-top:8px;}

/* ── STICKY FOOTER NAV ── */
.footer-nav{position:fixed;bottom:0;left:0;right:0;background:var(--sf);border-top:1px solid var(--bd);padding:10px 14px;display:flex;gap:10px;z-index:90;}
.fbtn{flex:1;padding:12px;border-radius:var(--r);border:none;font-size:14px;font-weight:600;cursor:pointer;transition:filter .15s;}
.fbtn-prev{background:var(--sf2);color:var(--tx2);border:1px solid var(--bd);}
.fbtn-next{background:var(--acd);color:#fff;}
.fbtn:disabled{opacity:.4;cursor:not-allowed;}

/* ── SUCCESS OVERLAY (SMART-style) ── */
.overlay{display:none;position:fixed;inset:0;background:rgba(15,69,48,.88);z-index:500;align-items:center;justify-content:center;}
.overlay.show{display:flex;animation:fi .2s ease;}
@keyframes fi{from{opacity:0}to{opacity:1}}
.obox{background:var(--sf);border-radius:var(--rl);padding:2.5rem 2.2rem;text-align:center;max-width:360px;width:90%;animation:overlayBounce .35s cubic-bezier(.34,1.56,.64,1) both;}
@keyframes overlayBounce{0%{transform:scale(.8);opacity:0;}60%{transform:scale(1.05);}100%{transform:scale(1);opacity:1;}}
.oicon{width:56px;height:56px;background:var(--acl);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;}
.oicon svg{width:28px;height:28px;fill:var(--ac);}
.obox h2{font-size:18px;font-weight:700;margin-bottom:.4rem;}
.obox p{font-size:13px;color:var(--tx2);line-height:1.5;}
.oname{font-family:"IBM Plex Mono",monospace;font-size:14px;font-weight:500;color:var(--acd);background:var(--acl);border-radius:var(--r);padding:8px 14px;margin:1rem 0;word-break:break-word;}
.bcls{margin-top:1.25rem;padding:9px 28px;background:var(--acd);color:#fff;border:none;border-radius:var(--r);font-size:13px;font-weight:600;cursor:pointer;}
</style>
</head>
<body>

<div id="loadOverlay">
  <div class="loadSpin"></div>
  <p id="loadMsg">Memuatkan rekod pesakit...</p>
</div>

<header style="display:flex;align-items:center;gap:12px;">
  <a href="javascript:void(0)" onclick="goBackToKaunter()" style="color:#fff;font-size:13px;text-decoration:none;display:flex;align-items:center;gap:4px;opacity:.9;flex-shrink:0;">◀ Kaunter</a>
  <h1 style="flex:1;">📋 E-Clerking — PRIMA</h1>
</header>

<div class="patient-banner">
  <div class="pat-avatar" id="patAvatar">?</div>
  <div class="pat-info">
    <div class="pat-name" id="patName">—</div>
    <div class="pat-meta">
      <span id="patIc">—</span>
      <span class="pat-age" id="patAge">— tahun</span>
      <span id="patPhone" style="display:none;">—</span>
    </div>
  </div>
  <div class="save-status" id="saveStatus"></div>
</div>
<div style="display:flex;gap:8px;align-items:center;margin:0 14px 10px;">
  <button class="q7-add-btn" style="margin-left:0" onclick="openHistory()">🕘 Sejarah <span id="histCount"></span></button>
  <button class="q7-add-btn" style="margin-left:0" onclick="startNewVisit()">➕ Kes Baru</button>
  <span class="save-status" id="visitLabel"></span>
</div>

<div class="qnav" id="qnav">
  <button class="qnav-btn active" data-q="1" onclick="showSection(1)">1. Simptom</button>
  <button class="qnav-btn" data-q="2" onclick="showSection(2)">2. Vitals</button>
  <button class="qnav-btn" data-q="3" onclick="showSection(3)">3. Sej. Perubatan/Alahan</button>
  <button class="qnav-btn" data-q="4" onclick="showSection(4)">4. Pemeriksaan/Investigasi</button>
  <button class="qnav-btn" data-q="5" onclick="showSection(5)">5. Prosedur</button>
  <button class="qnav-btn" data-q="6" onclick="showSection(6)">6. Diagnosis</button>
</div>

<!-- Q1 — SYMPTOMS -->
<div class="qsection active" id="qsec-1">
  <div class="qtitle">1. Sign &amp; Symptoms <span class="req-mark">*</span></div>
  <div class="qsub">Tandakan simptom yang berkaitan. Bilangan hari (pilihan) akan muncul selepas ditandakan. Wajib diisi.</div>
  <div id="symptomChips"></div>
  <div class="q-error" id="qErr-1"></div>
</div>

<!-- Q2 — VITALS -->
<div class="qsection" id="qsec-2">
  <div class="qtitle">2. Vital Signs</div>
  <div class="qsub">RR dan Pain Score <b>wajib diisi</b>. Nilai lain pilihan. Nilai luar julat normal akan berkelip merah (sesetengah carta belum ditetapkan).</div>

  <div class="vital-grid">
    <div class="vital-row">
      <label>Tekanan Darah (BP)</label>
      <div class="vital-input-pair">
        <input type="number" id="v-bp-sys" placeholder="Sistolik" inputmode="numeric" oninput="onVitalInput()">
        <span class="vital-sep">/</span>
        <input type="number" id="v-bp-dia" placeholder="Diastolik" inputmode="numeric" oninput="onVitalInput()">
        <span class="vital-unit">mmHg</span>
      </div>
      <span class="vital-flag" id="flag-bp"></span>
    </div>

    <div class="vital-row">
      <label>Pulse</label>
      <div class="vital-input-pair">
        <input type="number" id="v-pulse" placeholder="0" inputmode="numeric" oninput="onVitalInput()">
        <span class="vital-unit">bpm</span>
      </div>
      <span class="vital-flag" id="flag-pulse"></span>
    </div>

    <div class="vital-row">
      <label>SpO2</label>
      <div class="vital-input-pair">
        <input type="number" id="v-spo2" placeholder="0" inputmode="numeric" oninput="onVitalInput()">
        <span class="vital-unit">%</span>
      </div>
      <span class="vital-flag" id="flag-spo2"></span>
    </div>

    <div class="vital-row">
      <label>RR <span class="req-mark">*</span></label>
      <div class="vital-input-pair">
        <input type="number" id="v-rr" placeholder="0" inputmode="numeric" oninput="onVitalInput()">
        <span class="vital-unit">/min</span>
      </div>
      <span class="vital-flag" id="flag-rr"></span>
    </div>

    <div class="vital-row">
      <label>Glucometer</label>
      <div class="vital-input-pair">
        <input type="number" step="0.1" id="v-glu" placeholder="0.0" inputmode="decimal" oninput="onVitalInput()">
        <span class="vital-unit">mmol/L</span>
      </div>
      <div class="glu-flags">
        <span class="vital-flag" id="flag-glu-fast">Berpuasa: —</span>
        <span class="vital-flag" id="flag-glu-rand">Rawak: —</span>
      </div>
    </div>

    <div class="vital-row" style="align-items:flex-start;">
      <label>Pain Score <span class="req-mark">*</span></label>
      <div class="pain-scale" id="painScale"></div>
    </div>
  </div>
  <div class="q-error" id="qErr-2"></div>
</div>

<!-- Q3+Q4 — MEDICAL HISTORY + DRUG ALLERGY (merged page) -->
<div class="qsection" id="qsec-3">
  <div class="qtitle">3. Sejarah Perubatan</div>
  <div class="qsub">Tandakan sejarah perubatan berkaitan.</div>
  <div class="chip-grid" id="medHxChips"></div>
  <div class="chip-days" id="medHxOthersBox">
    <input type="text" id="medHxOthersInput" placeholder="Nyatakan sejarah perubatan lain..." style="flex:1;" oninput="MEDHX_OTHERS.text=this.value; saveQ3();">
  </div>

  <div class="q-divider"></div>
  <div class="qtitle">4. Alahan Ubat</div>
  <div class="qsub">Tandakan alahan ubat berkaitan.</div>
  <div class="chip-grid" id="allergyChips"></div>
  <div class="chip-days" id="allergyOthersBox">
    <input type="text" id="allergyOthersInput" placeholder="Nyatakan alahan ubat lain..." style="flex:1;" oninput="ALLERGY_OTHERS.text=this.value; saveQ4();">
  </div>
</div>

<!-- Q5+Q6 — PHYSICAL EXAM + INVESTIGATION (merged page) -->
<div class="qsection" id="qsec-4">
  <div class="qtitle">5. Pemeriksaan Fizikal</div>
  <div class="qsub">Tulis dapatan pemeriksaan fizikal.</div>
  <textarea class="plain-textarea" id="q5-text" rows="6" placeholder="cth: Alert, tidak pucat, tiada distress pernafasan..." oninput="onQ5Input(this.value)"></textarea>

  <div class="q-divider"></div>
  <div class="qtitle">6. Investigasi</div>
  <div class="qsub">Ada investigasi dijalankan?</div>
  <div class="q7-kes-row">
    <button type="button" class="q7-kes-btn sel-tidak" id="inv-no-btn" onclick="setInvestigation(false)">Tiada</button>
    <button type="button" class="q7-kes-btn" id="inv-yes-btn" onclick="setInvestigation(true)">Ada</button>
  </div>
  <textarea class="plain-textarea" id="q6-text" rows="4" placeholder="cth: FBC, RP, CXR..." style="display:none;" oninput="onQ6Input()"></textarea>
</div>

<!-- Q7A/Q7B — PROCEDURE, MANAGEMENT, REFER/DISCHARGE -->
<div class="qsection" id="qsec-5">
  <div class="qtitle">7. Prosedur &amp; Pengurusan</div>
  <div class="qsub">Sama seperti SMART — direkod serentak ke fail SMART dan rekod e-clerking pesakit ini.</div>

  <div class="q7-subtitle">Kes Kecemasan</div>
  <div class="q7-kes-row">
    <button type="button" class="q7-kes-btn" id="q7-kes-ya" onclick="selectQ7Kes('ya')">✅ Ya</button>
    <button type="button" class="q7-kes-btn" id="q7-kes-tidak" onclick="selectQ7Kes('tidak')">❌ Tidak</button>
  </div>

  <div class="q7-subtitle">Procedure(s)
    <button class="q7-add-btn" onclick="toggleQ7AddForm('proc')">+ Tambah Baru</button>
  </div>
  <div class="q7-add-form" id="q7-add-proc">
    <div class="q7-add-row">
