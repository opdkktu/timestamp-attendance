  w.document.write("<p style='font-family:Arial'>Menjana rekod...</p>");
  google.script.run
    .withSuccessHandler(function(res){
      if(res && res.status==="success") openPrintWindow(res.record, w);
      else { w.close(); alert("Ralat: "+(res&&res.message||"Gagal.")); }
    })
    .withFailureHandler(function(err){ w.close(); alert("Ralat: "+(err&&err.message||"")); })
    .getRecordForPrint(rowIndex);
}
function escapeHtml(s){ return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }
function openPrintWindow(record,w){
  var w=window.open("","_blank");
  var rows=[
    ["Masa", record.timestamp],
    ["1. Sign & Symptoms", record.q1],
    ["2. Vital Signs", record.q2],
    ["3. Sejarah Perubatan", record.q3],
    ["4. Alahan Ubat", record.q4],
    ["5. Pemeriksaan Fizikal", record.q5],
    ["6. Investigasi", record.q6],
    ["7a. Prosedur & Pengurusan", record.q7a],
    ["7b. Refer/Discharge", record.q7b],
    ["8. Diagnosis", record.q8]
  ];
  var body=rows.map(function(r){
    return "<div class='row'><div class='lbl'>"+escapeHtml(r[0])+"</div><div class='val'>"+escapeHtml(r[1]||"—")+"</div></div>";
  }).join("");
  var html = "<html><head><title>E-Clerking - "+escapeHtml(record.nama)+"</title>"+
    "<meta charset='utf-8'>"+
    "<style>body{font-family:Arial,sans-serif;padding:24px;color:#111;} h1{font-size:18px;border-bottom:2px solid #0F4530;padding-bottom:8px;} .row{margin-bottom:14px;} .lbl{font-weight:700;font-size:12px;text-transform:uppercase;color:#555;margin-bottom:3px;} .val{font-size:14px;white-space:pre-wrap;}</style>"+
    "</head><body>"+
    "<h1>E-Clerking — "+escapeHtml(record.nama)+" ("+escapeHtml(record.ic)+")</h1>"+
    body+
    "<script>window.onload=function(){window.print();}<"+"/script>"+
    "</body></html>";
  w.document.write(html);
  w.document.close();
}

// ── Q8 — DIAGNOSIS (tag list + PRIMA sync) ──
var Q8_LIST = [];
var Q8_SELECTED = [];
function loadQ8List(cb){
  google.script.run
    .withSuccessHandler(function(res){
      if(res && res.status==="success"){ Q8_LIST = res.diagnosis||[]; }
      renderQ8List("");
      if(res && res.note){ document.getElementById("q8SyncNote").textContent="ℹ "+res.note; }
      if(cb) cb();
    })
    .withFailureHandler(function(){ if(cb) cb(); })
    .getDiagnosisList();
}
function renderQ8List(q){
  var listEl=document.getElementById("q8-list");
  if(!listEl) return;
  var qLow=(q||"").toLowerCase().trim();
  var filtered = qLow ? Q8_LIST.filter(function(x){ return x.toLowerCase().indexOf(qLow)!==-1; }) : Q8_LIST.slice();
  filtered.sort(function(a,b){
    var aC=Q8_SELECTED.indexOf(a)!==-1, bC=Q8_SELECTED.indexOf(b)!==-1;
    if(aC&&!bC) return -1; if(!aC&&bC) return 1; return a.localeCompare(b);
  });
  if(!filtered.length){ listEl.innerHTML="<div style='padding:10px;font-size:12px;color:var(--tx3);'>Tiada padanan</div>"; return; }
  listEl.innerHTML="";
  filtered.forEach(function(item){
    var checked=Q8_SELECTED.indexOf(item)!==-1;
    var div=document.createElement("div");
    div.className="q7-multi-item"+(checked?" checked":"");
    var chk=document.createElement("input"); chk.type="checkbox"; if(checked) chk.checked=true;
    var lbl=document.createElement("span"); lbl.textContent=item; lbl.style.flex="1";
    div.appendChild(chk); div.appendChild(lbl);
    div.onclick=function(){
      chk.checked=!chk.checked;
      if(chk.checked){ if(Q8_SELECTED.indexOf(item)===-1) Q8_SELECTED.push(item); }
      else { Q8_SELECTED = Q8_SELECTED.filter(function(x){ return x!==item; }); }
      renderQ8List(document.getElementById("q8-search").value);
      renderQ8Tags();
      saveQ8();
    };
    listEl.appendChild(div);
  });
}
function addQ8Custom(){
  var inp=document.getElementById("q8-custom-input");
  var v=(inp.value||"").trim();
  if(!v) return;
  addQ8Tag(v);
  inp.value="";
}
function addQ8Tag(v){
  if(Q8_SELECTED.indexOf(v)===-1) Q8_SELECTED.push(v);
  renderQ8List(document.getElementById("q8-search")?document.getElementById("q8-search").value:"");
  renderQ8Tags();
  saveQ8();
}
function removeQ8Tag(v){
  Q8_SELECTED = Q8_SELECTED.filter(function(x){ return x!==v; });
  renderQ8List(document.getElementById("q8-search")?document.getElementById("q8-search").value:"");
  renderQ8Tags();
  saveQ8();
}
function renderQ8Tags(){
  var wrap=document.getElementById("q8Tags");
  if(!Q8_SELECTED.length){ wrap.innerHTML="<span style='font-size:12px;color:var(--tx3);font-style:italic;'>Tiada dipilih</span>"; return; }
  wrap.innerHTML=Q8_SELECTED.map(function(v){
    return "<span class='q7-sel-tag'>"+v+"<span class='rm' onclick=\"removeQ8Tag('"+v.replace(/'/g,"\\'")+"')\">✕</span></span>";
  }).join("");
}
var _q8Timer=null;
function saveQ8(immediate){
  var run=function(){
    if(!CURRENT.rowIndex) return;
    var str=Q8_SELECTED.join(", ");
    setSaveStatus("","Menyimpan...");
    google.script.run
      .withSuccessHandler(function(r){
        if(r && r.status==="success"){
          setSaveStatus("ok","✓ Disimpan");
          markFilled(6, str.length>0);
          var noteEl=document.getElementById("q8SyncNote");
          if(r.primaSync==="skipped") noteEl.textContent="ℹ PRIMA belum disegerakkan (PRIMA_FILE_ID belum ditetapkan).";
          else if(r.primaSync==="notfound") noteEl.textContent="⚠ Pesakit tidak dijumpai dalam PRIMA hari ini — disimpan di e-clerking sahaja.";
          else if(r.primaSync==="success") noteEl.textContent="✓ Disegerakkan ke PRIMA (TODAY LIST).";
          else if(r.primaSync==="error") noteEl.textContent="⚠ Ralat sync PRIMA: "+(r.primaSyncMessage||"Tidak diketahui.");
        } else setSaveStatus("err","Ralat simpan");
      })
      .withFailureHandler(function(){ setSaveStatus("err","Ralat simpan"); })
      .saveDiagnosisEverywhere(CURRENT.rowIndex, CURRENT.identifier, str);
  };
  clearTimeout(_q8Timer);
  if(immediate) run(); else _q8Timer=setTimeout(run,500);
}
function restoreQ8(str){
  if(!str) return;
  Q8_SELECTED = str.split(",").map(function(s){return s.trim();}).filter(Boolean);
  renderQ8List("");
  renderQ8Tags();
  markFilled(6, Q8_SELECTED.length>0);
}
function testPrimaConnection(){
  var noteEl=document.getElementById("q8SyncNote");
  noteEl.textContent="Menguji sambungan...";
  google.script.run
    .withSuccessHandler(function(res){
      if(res && res.status==="success" && res.info){
        var i=res.info;
        var txt="[Fail PRIMA_FILE_ID ditetapkan: "+(i.primaFileIdSet?"Ya":"Tidak")+
          "] [Sheet dijumpai: "+(i.sheetFound?"Ya":"Tidak")+
          "] [Baris data: "+i.totalDataRows+"] — "+i.message;
        if(i.identifierRaw !== i.identifierProvided){
          txt += "\n(Nilai mentah diterima: '"+i.identifierRaw+"' → selepas dibersihkan: '"+i.identifierProvided+"')";
        }
        if(i.sampleRows && i.sampleRows.length){
          txt += "\nContoh data tersimpan dalam PRIMA hari ini:";
          i.sampleRows.forEach(function(r,idx){
            txt += "\n  #"+(idx+1)+" IC='"+r.icRaw+"' Pasport='"+r.ppRaw+"'";
          });
        }
        noteEl.textContent = txt;
        noteEl.style.whiteSpace = "pre-line";
      } else {
        noteEl.textContent="⚠ Ralat menguji sambungan.";
      }
    })
    .withFailureHandler(function(err){ noteEl.textContent="⚠ Ralat: "+(err&&err.message?err.message:""); })
    .testPrimaConnection(CURRENT.identifier);
}

// ── FINISH ──
function finishClerking(){
  saveQ1(true); saveQ2(true); saveQ3(true); saveQ4(true); saveQ5(true); saveQ6(true); saveQ8(true);
  showSuccessOverlay("✓ E-Clerking Selesai", NAMA, "Semua jawapan telah disimpan.");
}

// ── LOAD / INIT RECORD ──
function initPage(){
  renderPatientBanner();
  loadVitalsConfig(function(){
    loadQ7Ranges(function(){
      loadQ8List(function(){
        google.script.run
          .withSuccessHandler(function(pl){
            if(pl && pl.status==="success"){
              SYMPTOM_LIST = pl.symptoms||[]; renderSymptomChips();
              MEDHX_LIST = pl.medicalHistory||[]; renderMedHxChips();
              ALLERGY_LIST = pl.drugAllergy||[]; renderAllergyChips();
            }
            loadOrCreateRecord();
          })
          .withFailureHandler(function(){ SYMPTOM_LIST=[]; loadOrCreateRecord(); })
          .getPickLists();
      });
    });
  });
}
// ── RESET + APPLY RECORD ──
function resetForm(){
  [_q1Timer,_q2Timer,_q3Timer,_q4Timer,_q5Timer,_q6Timer,_q8Timer].forEach(clearTimeout);
  SEL_SYMPTOMS={}; OTHERS_SYM={checked:false,text:""};
  SEL_MEDHX={}; MEDHX_OTHERS={checked:false,text:""};
  SEL_ALLERGY={}; ALLERGY_OTHERS={checked:false,text:""};
  PAIN_SCORE=null; INVESTIGATION_YES=false; Q7_KES=null;
  Q7B_SEL={refer:false,discharge:false}; Q7_SEL={proc:{},med:{}}; Q8_SELECTED=[];
  ["v-bp-sys","v-bp-dia","v-pulse","v-spo2","v-rr","v-glu","q5-text","q6-text",
   "q7b-note","medHxOthersInput","allergyOthersInput","q7-performer"]
    .forEach(function(id){ document.getElementById(id).value=""; });
  document.querySelectorAll("#q7bChips .chip").forEach(function(c){ c.classList.remove("checked"); });
  document.getElementById("q7-kes-ya").className="q7-kes-btn";
  document.getElementById("q7-kes-tidak").className="q7-kes-btn";
  for(var i=1;i<=6;i++) markFilled(i,false);
  renderSymptomChips(); renderMedHxChips(); renderAllergyChips(); renderPainScale();
  renderQ7Multi("proc",""); renderQ7Multi("med",""); renderQ7Tags("proc"); renderQ7Tags("med");
  renderQ8List(""); renderQ8Tags(); updateInvUI(false);
  onVitalInput(); clearTimeout(_q2Timer);
  showSection(1);
}

function applyRecord(rec, applyDefaults){
  resetForm();
  CURRENT.rowIndex = rec.rowIndex;
  CURRENT.readOnlyOld = !applyDefaults;
  document.getElementById("visitLabel").textContent =
    (applyDefaults ? "Kes semasa" : "Rekod lama") + (rec.timestamp ? " · "+rec.timestamp : "");

  if(rec.q1) restoreQ1(rec.q1);
  if(rec.q2) restoreQ2(rec.q2);
  if(rec.q3) restoreQ3(rec.q3);
  else if(applyDefaults){ SEL_MEDHX["Unknown Medical History"]=true; renderMedHxChips(); saveQ3(true); }
  if(rec.q4) restoreQ4(rec.q4);
  else if(applyDefaults){ SEL_ALLERGY["Unknown Drug Allergy"]=true; renderAllergyChips(); saveQ4(true); }
  if(rec.q5){ document.getElementById("q5-text").value=rec.q5; markFilled(4,true); }
  if(rec.q6) restoreQ6(rec.q6);
  else if(applyDefaults){ updateInvUI(false); saveQ6(true); }
  if(rec.q7a || rec.q7b) restoreQ7(rec.q7a, rec.q7b);
  else if(applyDefaults){
    var vs=Q7_RANGES.procedures.filter(function(p){return p.toLowerCase()==="vital sign";})[0];
    if(vs){ Q7_SEL.proc[vs]=true; renderQ7Multi("proc",""); renderQ7Tags("proc"); }
  }
  if(rec.q8) restoreQ8(rec.q8);
  // performer is restored by restoreQ7 (remove its setTimeout and set value directly)
}
function todayStr(){
  var d=new Date(), p=function(n){return String(n).padStart(2,"0");};
  return p(d.getDate())+"/"+p(d.getMonth()+1)+"/"+d.getFullYear();
}
function loadOrCreateRecord(){
  google.script.run
    .withSuccessHandler(function(r){
      VISITS=(r&&r.visits)||[];
      document.getElementById("histCount").textContent="("+VISITS.length+")";
      if(!VISITS.length){ createVisit(); return; }
      document.getElementById("loadOverlay").classList.add("hide");
      showChooser();
    })
    .withFailureHandler(function(err){
      document.getElementById("loadOverlay").classList.add("hide");
      setSaveStatus("err","Gagal memuatkan: "+(err&&err.message||""));
    })
    .getVisitHistory(CURRENT.identifier);
}
function showChooser(){
  document.getElementById("chName").textContent = NAMA+" · "+CURRENT.identifier;
  var today=todayStr();
  document.getElementById("chList").innerHTML = VISITS.map(function(v){
    var isToday = v.timestamp.substring(0,10)===today;
    return "<div style='border:1px solid var(--bd);border-radius:10px;padding:10px;margin-bottom:8px;cursor:pointer' onclick='chooseVisit("+v.rowIndex+")'>"+
      "<b style='font-size:13px'>"+escapeHtml(v.timestamp)+(isToday?" · HARI INI (sambung)":"")+"</b>"+
      "<div style='font-size:12px;color:var(--tx2);margin-top:4px'>Simptom: "+escapeHtml(v.q1||"—")+"<br>Diagnosis: "+escapeHtml(v.q8||"—")+"</div></div>";
  }).join("");
  document.getElementById("chooseOverlay").classList.add("show");
}
function toggleChList(){
  var el=document.getElementById("chList");
  el.style.display = el.style.display==="none" ? "block" : "none";
}
function chooseVisit(row){ document.getElementById("chooseOverlay").classList.remove("show"); openVisit(row); }
function chooseNew(){ document.getElementById("chooseOverlay").classList.remove("show"); createVisit(); }

function createVisit(){
  document.getElementById("loadOverlay").classList.remove("hide");
  google.script.run
    .withSuccessHandler(function(res){
      document.getElementById("loadOverlay").classList.add("hide");
      if(res&&res.status==="success"){ applyRecord(res.record,true); loadHistory(); }
      else alert(res&&res.message||"Gagal.");
    })
    .withFailureHandler(function(e){ document.getElementById("loadOverlay").classList.add("hide"); alert(e.message); })
    .getOrInitRecord(NAMA, CURRENT.identifier, true);
}
function startNewVisit(){
  if(!confirm("Mulakan rekod clerking BARU untuk pesakit ini?")) return;
  createVisit();
}
function openVisit(rowIndex){
  document.getElementById("histOverlay").classList.remove("show");
  if(rowIndex===CURRENT.rowIndex) return;
  var v = VISITS.filter(function(x){return x.rowIndex===rowIndex;})[0];
  var isToday = v && v.timestamp.substring(0,10)===todayStr();
  document.getElementById("loadOverlay").classList.remove("hide");
  google.script.run
    .withSuccessHandler(function(res){
      document.getElementById("loadOverlay").classList.add("hide");
      if(res&&res.status==="success") applyRecord(res.record, isToday); // defaults only for today's
      else alert(res&&res.message||"Gagal.");
    })
    .withFailureHandler(function(e){ document.getElementById("loadOverlay").classList.add("hide"); alert(e.message); })
    .getRecordByRow(rowIndex, CURRENT.identifier);
}

// ── HISTORY ──
var VISITS=[];
function loadHistory(){
  google.script.run.withSuccessHandler(function(r){
    VISITS=(r&&r.visits)||[];
    document.getElementById("histCount").textContent="("+VISITS.length+")";
  }).getVisitHistory(CURRENT.identifier);
}
function openHistory(){
  var el=document.getElementById("histList");
  if(!VISITS.length){ el.innerHTML="<p style='font-size:13px;color:var(--tx3)'>Tiada sejarah.</p>"; }
  else el.innerHTML=VISITS.map(function(v){
    var cur = v.rowIndex===CURRENT.rowIndex ? " (dibuka)" : "";
    return "<div style='border:1px solid var(--bd);border-radius:10px;padding:10px;margin-bottom:8px'>"+
      "<b style='font-size:13px'>"+escapeHtml(v.timestamp)+cur+"</b>"+
      "<div style='font-size:12px;color:var(--tx2);margin:4px 0'>Simptom: "+escapeHtml(v.q1||"—")+"<br>Diagnosis: "+escapeHtml(v.q8||"—")+"</div>"+
      "<button class='q7-add-btn' style='margin-left:0' onclick='openVisit("+v.rowIndex+")'>Buka</button> "+
      "<button class='q7-add-btn' style='margin-left:0' onclick='printRecord("+v.rowIndex+")'>Cetak</button></div>";
  }).join("");
  document.getElementById("histOverlay").classList.add("show");
}
function openVisit(rowIndex){
  document.getElementById("histOverlay").classList.remove("show");
  if(rowIndex===CURRENT.rowIndex) return;
  var latest = VISITS.length && VISITS[0].rowIndex===rowIndex;
  google.script.run.withSuccessHandler(function(res){
    if(res&&res.status==="success") applyRecord(res.record, latest); // defaults only for newest
    else alert(res&&res.message||"Gagal.");
  }).getRecordByRow(rowIndex, CURRENT.identifier);
}
function startNewVisit(){
  if(!confirm("Mulakan rekod clerking BARU untuk pesakit ini?")) return;
  document.getElementById("loadOverlay").classList.remove("hide");
  google.script.run.withSuccessHandler(function(res){
    document.getElementById("loadOverlay").classList.add("hide");
    if(res&&res.status==="success"){ applyRecord(res.record, true); loadHistory(); }
  }).withFailureHandler(function(e){
    document.getElementById("loadOverlay").classList.add("hide"); alert(e.message);
  }).getOrInitRecord(NAMA, CURRENT.identifier, true);
}

initPage();
